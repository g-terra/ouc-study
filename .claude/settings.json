{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run lint)",
      "Bash(npm test)",
      "Bash(npm test -- *)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm run e2e)",
      "Bash(npm run e2e -- *)",
      "Bash(npm run check:public)",
      "Bash(npm run dev:agents)",
      "Bash(npx playwright test *)",
      "Bash(node --import tsx --test *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(./.eclass-token)",
      "Read(**/.eclass-token)",
      "Edit(./.eclass-token)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [{ "type": "command", "command": "node dev/session-start.mjs", "timeout": 600 }]
      }
    ]
  }
}
