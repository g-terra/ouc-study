{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "content": {
      "inputs": ["../../semesters/**/semester.json", "../../semesters/**/_meta/**", "../../semesters/**/notes/**", "../../semesters/**/assignments/**", "src/**"],
      "outputs": ["../../apps/web/public/data/**"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^content"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^content"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "outputs": []
    }
  }
}
